APP_NAME="PinSA Portfolio"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Hostinger MySQL (hPanel → Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Hostinger-safe drivers only — never redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@your-domain.example
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ENCRYPTION=ssl

# Ops maintenance (rotate after first deploy; leave empty to disable)
OPS_TOKEN=change-me-to-a-long-random-string
OPS_THROTTLE=5

# Milestone 7 — optional; leave keys empty so AI stays fully hidden
AI_PROVIDER=openai
AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_CENTS=2000
AI_CACHE_TTL=3600

VITE_APP_NAME="${APP_NAME}"
